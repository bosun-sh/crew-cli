{
  "name": "@bosun-sh/crew-cli",
  "version": "0.3.0-rc.1",
  "description": "Crew CLI: connect your repository and manage its background worker.",
  "private": false,
  "bin": {
    "crew": "dist/cli.js"
  },
  "files": [
    "dist",
    "contracts",
    "docs",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "install.sh"
  ],
  "packageManager": "bun@1.3.9",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosun-sh/crew-cli.git"
  },
  "bugs": {
    "url": "https://github.com/bosun-sh/crew-cli/issues"
  },
  "homepage": "https://github.com/bosun-sh/crew-cli#readme",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "bun run src/cli.ts",
    "start": "node dist/cli.js",
    "prepack": "bun run build",
    "check": "bun run quality && bun run typecheck && bun test && bun run build",
    "quality": "bun run scripts/check-quality.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "bun-types": "^1.3.0",
    "typescript": "^7.0.2"
  }
}
